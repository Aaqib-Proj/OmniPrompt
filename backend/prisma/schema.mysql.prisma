// Dedicated MySQL Prisma Schema for PromptIt
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  name            String?
  avatarUrl       String?  @db.VarChar(500)
  bio             String?  @db.Text
  githubHandle    String?
  twitterHandle   String?
  role            String   @default("USER")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prompts              Prompt[]              @relation("AuthorPrompts")
  editedVersions       PromptVersion[]       @relation("EditorVersions")
  stars                Star[]
  collections          Collection[]
  editSuggestions      EditSuggestion[]      @relation("AuthorSuggestions")
  feedbackThreads      FeedbackThread[]
  comments             Comment[]
  reactions            Reaction[]
  badges               UserBadge[]
  apiKeys              ApiKey[]
  challengeSubmissions ChallengeSubmission[]
  following            Follow[]              @relation("FollowerUser")
  followers            Follow[]              @relation("FollowingUser")

  @@index([role])
  @@index([createdAt])
}

model Model {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  provider      String
  modality      String
  logoUrl       String?  @db.VarChar(500)
  badgeColor    String?
  description   String   @db.Text
  contextWindow String?
  officialUrl   String?  @db.VarChar(500)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  prompts       Prompt[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  icon        String
  badgeColor  String
  createdAt   DateTime @default(now())

  prompts     Prompt[]
}

model Prompt {
  id                  String   @id @default(uuid())
  authorId            String
  title               String
  slug                String   @unique
  shortDescription    String   @db.VarChar(500)
  fullPrompt          String   @db.LongText
  descriptionMd       String   @db.LongText
  categoryId          String
  modelId             String
  forkedFromPromptId  String?
  license             String   @default("MIT-Prompt")
  visibility          String   @default("PUBLIC")
  copyCount           Int      @default(0)
  viewsCount          Int      @default(0)
  isFeatured          Boolean  @default(false)
  sandboxCode         String?  @db.LongText
  // Set for prompts imported from open datasets (see prisma/import-open-datasets.ts)
  sourceName          String?
  sourceUrl           String?  @db.Text
  attribution         String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  author              User                @relation("AuthorPrompts", fields: [authorId], references: [id], onDelete: Cascade)
  category            Category            @relation(fields: [categoryId], references: [id])
  model               Model               @relation(fields: [modelId], references: [id])
  forkedFrom          Prompt?             @relation("PromptForkLineage", fields: [forkedFromPromptId], references: [id], onDelete: SetNull)
  remixes             Prompt[]            @relation("PromptForkLineage")

  versions            PromptVersion[]
  media               PromptMedia[]
  tags                PromptTag[]
  stars               Star[]
  forksAsParent       Fork[]              @relation("ParentFork")
  forksAsChild        Fork[]              @relation("ChildFork")
  collectionItems     CollectionItem[]
  editSuggestions     EditSuggestion[]
  feedbackThreads     FeedbackThread[]
  comments            Comment[]
  reactions           Reaction[]
  packItems           PromptPackItem[]
  challengeSubmissions ChallengeSubmission[]

  @@index([categoryId])
  @@index([modelId])
  @@index([authorId])
  @@index([forkedFromPromptId])
  @@index([visibility, createdAt])
  @@index([visibility, viewsCount])
  @@index([visibility, copyCount])
  @@index([visibility, isFeatured])
  @@index([visibility, categoryId])
  @@index([visibility, modelId])
  @@index([authorId, createdAt])
  @@fulltext([title, shortDescription])
}

model PromptVersion {
  id              String   @id @default(uuid())
  promptId        String
  versionNumber   String
  title           String
  promptText      String   @db.LongText
  parametersJson  String   @db.Text
  changelog       String?  @db.Text
  editorId        String
  createdAt       DateTime @default(now())

  prompt          Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  editor          User     @relation("EditorVersions", fields: [editorId], references: [id])
  media           PromptMedia[]

  @@index([promptId])
}

model PromptMedia {
  id            String   @id @default(uuid())
  promptId      String
  versionId     String?
  mediaType     String
  url           String   @db.VarChar(1000)
  thumbnailUrl  String?  @db.VarChar(1000)
  caption       String?  @db.Text
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  prompt        Prompt         @relation(fields: [promptId], references: [id], onDelete: Cascade)
  version       PromptVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([promptId])
}

model Tag {
  id        String      @id @default(uuid())
  name      String      @unique
  slug      String      @unique
  prompts   PromptTag[]
}

model PromptTag {
  promptId  String
  tagId     String

  prompt    Prompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
}

model Star {
  id        String   @id @default(uuid())
  userId    String
  promptId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
  @@index([promptId])
}

model Fork {
  id              String   @id @default(uuid())
  parentPromptId  String
  childPromptId   String
  createdAt       DateTime @default(now())

  parentPrompt    Prompt   @relation("ParentFork", fields: [parentPromptId], references: [id], onDelete: Cascade)
  childPrompt     Prompt   @relation("ChildFork", fields: [childPromptId], references: [id], onDelete: Cascade)

  @@index([parentPromptId])
  @@index([childPromptId])
}

model Collection {
  id          String           @id @default(uuid())
  userId      String
  name        String
  slug        String
  description String?          @db.Text
  isPublic    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([userId, slug])
  @@index([userId])
}

model CollectionItem {
  id            String     @id @default(uuid())
  collectionId  String
  promptId      String
  addedAt       DateTime   @default(now())

  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  prompt        Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([collectionId, promptId])
}

model EditSuggestion {
  id                  String   @id @default(uuid())
  promptId            String
  authorId            String
  proposedTitle       String
  proposedPromptText  String   @db.LongText
  proposedParameters  String?  @db.Text
  notes               String?  @db.Text
  status              String   @default("OPEN")
  mergedAt            DateTime?
  createdAt           DateTime @default(now())

  prompt              Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author              User     @relation("AuthorSuggestions", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([authorId])
}

model FeedbackThread {
  id        String    @id @default(uuid())
  promptId  String
  authorId  String
  title     String
  status    String    @default("OPEN")
  tag       String    @default("feedback")
  createdAt DateTime  @default(now())

  prompt    Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([promptId])
}

model Comment {
  id              String          @id @default(uuid())
  promptId        String
  threadId        String?
  userId          String
  parentCommentId String?
  bodyMd          String          @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  prompt          Prompt          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  thread          FeedbackThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment   Comment?        @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")
  reactions       Reaction[]

  @@index([promptId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  userId    String
  promptId  String?
  commentId String?
  type      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([commentId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String
  icon        String
  tier        String      @default("BRONZE")
  createdAt   DateTime    @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model PromptPack {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  description     String           @db.Text
  icon            String
  category        String
  isFeatured      Boolean          @default(false)
  downloadsCount  Int              @default(0)
  createdAt       DateTime         @default(now())

  items           PromptPackItem[]
}

model PromptPackItem {
  id          String     @id @default(uuid())
  packId      String
  promptId    String
  orderIndex  Int        @default(0)

  pack        PromptPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  prompt      Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([packId, promptId])
}

model Challenge {
  id          String                @id @default(uuid())
  title       String
  slug        String                @unique
  description String                @db.Text
  theme       String
  prize       String
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())

  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id          String    @id @default(uuid())
  challengeId String
  promptId    String
  userId      String
  votesCount  Int       @default(0)
  createdAt   DateTime  @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  prompt      Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, promptId])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyPrefix   String
  keyHash     String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
