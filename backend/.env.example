# Server Port
PORT=5000

# SQLite (Zero-friction local development)
DATABASE_URL="file:./dev.db"

# MySQL Configuration (Production / Docker)
# To use MySQL:
# 1. Update prisma/schema.prisma datasource provider to "mysql" (or copy prisma/schema.mysql.prisma to schema.prisma)
# 2. Set DATABASE_URL="mysql://root:yourpassword@localhost:3306/promptit"
# 3. Run: npm run prisma:push && npm run prisma:seed

# Security
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_change_in_production"
NODE_ENV=development

# Frontend Client Origin
CORS_ORIGIN="http://localhost:5173"

# Google OAuth (Optional - for Google Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
